{
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "title": "Canonical",
          "type": "string"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Tolerance",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/AnswerType"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/PremiseValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "type",
        "value",
        "canonical"
      ],
      "title": "Answer",
      "type": "object"
    },
    "AnswerType": {
      "enum": [
        "label",
        "int",
        "float",
        "zone",
        "premise"
      ],
      "title": "AnswerType",
      "type": "string"
    },
    "ErrorCode": {
      "description": "Declared in priority order: index 0 wins QuarantineRecord.primary_code.",
      "enum": [
        "E_SCHEMA",
        "E_DIGEST_MISMATCH",
        "E_FONT",
        "E_OOB",
        "E_LABEL_MISMATCH",
        "E_UNEXPLAINED_INK",
        "E_BEAUTY_MISMATCH",
        "E_OCCLUDED_CROSSING",
        "E_WITNESS_OCCLUDED",
        "E_TANGENT_CROSSING",
        "E_ILLEGIBLE_RES",
        "E_NEEDLE_OFFCENTER",
        "E_ZORDER",
        "E_SCALE_MISMATCH",
        "E_CROSSING_SPACING",
        "E_TERMINAL_CLEARANCE",
        "E_OCR_FAIL",
        "E_TRACE_NO_TERMINAL",
        "E_TRACE_AMBIGUOUS",
        "E_ZONE_UNRESOLVED",
        "E_AMBIGUOUS_ARGMAX",
        "E_CLAIM_MISMATCH",
        "E_D1_D3_MISMATCH",
        "E_D1_D2_MISMATCH",
        "E_TWIN_INVALID"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "Op": {
      "enum": [
        "TRACE",
        "CROSS",
        "ONTOP",
        "READ",
        "COUNT",
        "CMP",
        "ARGMAX",
        "ZONE",
        "READ_ALL",
        "GAUGE_OF"
      ],
      "title": "Op",
      "type": "string"
    },
    "PremiseValue": {
      "additionalProperties": false,
      "properties": {
        "premise_holds": {
          "title": "Premise Holds",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "premise_holds",
        "value"
      ],
      "title": "PremiseValue",
      "type": "object"
    },
    "StepTrace": {
      "additionalProperties": false,
      "properties": {
        "codes": {
          "items": {
            "$ref": "#/$defs/ErrorCode"
          },
          "title": "Codes",
          "type": "array"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "inputs": {
          "items": {},
          "title": "Inputs",
          "type": "array"
        },
        "op": {
          "$ref": "#/$defs/Op"
        },
        "output": {
          "title": "Output"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "op",
        "inputs",
        "output"
      ],
      "title": "StepTrace",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "CERTIFIED",
        "QUARANTINED"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "WitnessCheck": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "metric": {
          "title": "Metric",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "obj_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obj Id"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "name",
        "passed",
        "metric",
        "threshold",
        "code"
      ],
      "title": "WitnessCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agree": {
      "title": "Agree",
      "type": "boolean"
    },
    "bundle_id": {
      "pattern": "^kw-[0-9a-f]{20}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/WitnessCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "claims_checked": {
      "minimum": 0,
      "title": "Claims Checked",
      "type": "integer"
    },
    "claims_failed": {
      "minimum": 0,
      "title": "Claims Failed",
      "type": "integer"
    },
    "codes": {
      "items": {
        "$ref": "#/$defs/ErrorCode"
      },
      "title": "Codes",
      "type": "array"
    },
    "d1": {
      "$ref": "#/$defs/Answer"
    },
    "d2": {
      "anyOf": [
        {
          "$ref": "#/$defs/Answer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "d3": {
      "$ref": "#/$defs/Answer"
    },
    "kernel_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Kernel Sha256",
      "type": "string"
    },
    "kernel_version": {
      "default": "1.0.0",
      "title": "Kernel Version",
      "type": "string"
    },
    "ocr_engine": {
      "enum": [
        "rapidocr",
        "template"
      ],
      "title": "Ocr Engine",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepTrace"
      },
      "title": "Steps",
      "type": "array"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "bundle_id",
    "kernel_sha256",
    "ocr_engine",
    "d1",
    "d3",
    "agree",
    "steps",
    "claims_checked",
    "claims_failed",
    "checks",
    "verdict"
  ],
  "title": "Certificate",
  "type": "object"
}
