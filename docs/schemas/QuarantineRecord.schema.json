        "E_TANGENT_CROSSING",
        "E_ILLEGIBLE_RES",
        "E_NEEDLE_OFFCENTER",
        "E_ZORDER",
        "E_SCALE_MISMATCH",
        "E_CROSSING_SPACING",
        "E_TERMINAL_CLEARANCE",
        "E_OCR_FAIL",
        "E_TRACE_NO_TERMINAL",
        "E_TRACE_AMBIGUOUS",
        "E_ZONE_UNRESOLVED",
        "E_AMBIGUOUS_ARGMAX",
        "E_CLAIM_MISMATCH",
        "E_D1_D3_MISMATCH",
        "E_D1_D2_MISMATCH",
        "E_TWIN_INVALID"
