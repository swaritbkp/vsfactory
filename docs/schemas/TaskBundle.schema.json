{
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "title": "Canonical",
          "type": "string"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Tolerance",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/AnswerType"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/PremiseValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "type",
        "value",
        "canonical"
      ],
      "title": "Answer",
      "type": "object"
    },
    "AnswerType": {
      "enum": [
        "label",
        "int",
        "float",
        "zone",
        "premise"
      ],
      "title": "AnswerType",
      "type": "string"
    },
    "Certificate": {
      "additionalProperties": false,
      "properties": {
        "agree": {
          "title": "Agree",
          "type": "boolean"
        },
        "bundle_id": {
          "pattern": "^kw-[0-9a-f]{20}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/WitnessCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "claims_checked": {
          "minimum": 0,
          "title": "Claims Checked",
          "type": "integer"
        },
        "claims_failed": {
          "minimum": 0,
          "title": "Claims Failed",
          "type": "integer"
        },
        "codes": {
          "items": {
            "$ref": "#/$defs/ErrorCode"
          },
          "title": "Codes",
          "type": "array"
        },
        "d1": {
          "$ref": "#/$defs/Answer"
        },
        "d2": {
          "anyOf": [
            {
              "$ref": "#/$defs/Answer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "d3": {
          "$ref": "#/$defs/Answer"
        },
        "kernel_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Kernel Sha256",
          "type": "string"
        },
        "kernel_version": {
          "default": "1.0.0",
          "title": "Kernel Version",
          "type": "string"
        },
        "ocr_engine": {
          "enum": [
            "rapidocr",
            "template"
          ],
          "title": "Ocr Engine",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/StepTrace"
          },
          "title": "Steps",
          "type": "array"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "bundle_id",
        "kernel_sha256",
        "ocr_engine",
        "d1",
        "d3",
        "agree",
        "steps",
        "claims_checked",
        "claims_failed",
        "checks",
        "verdict"
      ],
      "title": "Certificate",
      "type": "object"
    },
    "ErrorCode": {
      "description": "Declared in priority order: index 0 wins QuarantineRecord.primary_code.",
      "enum": [
        "E_SCHEMA",
        "E_DIGEST_MISMATCH",
        "E_FONT",
        "E_OOB",
        "E_LABEL_MISMATCH",
        "E_UNEXPLAINED_INK",
        "E_BEAUTY_MISMATCH",
        "E_OCCLUDED_CROSSING",
        "E_TANGENT_CROSSING",
        "E_ILLEGIBLE_RES",
        "E_NEEDLE_OFFCENTER",
        "E_ZORDER",
        "E_SCALE_MISMATCH",
        "E_CROSSING_SPACING",
        "E_TERMINAL_CLEARANCE",
        "E_OCR_FAIL",
        "E_TRACE_NO_TERMINAL",
        "E_TRACE_AMBIGUOUS",
        "E_ZONE_UNRESOLVED",
        "E_AMBIGUOUS_ARGMAX",
        "E_CLAIM_MISMATCH",
        "E_D1_D3_MISMATCH",
        "E_D1_D2_MISMATCH",
        "E_TWIN_INVALID"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "Family": {
      "enum": [
        "T1_TRACE",
        "T2_CROSS",
        "T3_ONTOP",
        "G1_READ",
        "G2_ZONE",
        "P1_READ_TRACE",
        "P2_ZONE_TRACE",
        "P3_ARGMAX_PORT",
        "P4_COUNT_ZONE",
        "P5_PREMISE_CONTROL",
        "T_GASLIGHT"
      ],
      "title": "Family",
      "type": "string"
    },
    "Op": {
      "enum": [
        "TRACE",
        "CROSS",
        "ONTOP",
        "READ",
        "COUNT",
        "CMP",
        "ARGMAX",
        "ZONE",
        "READ_ALL",
        "GAUGE_OF"
      ],
      "title": "Op",
      "type": "string"
    },
    "Premise": {
      "additionalProperties": false,
      "properties": {
        "claimed_zone": {
          "$ref": "#/$defs/ZoneName"
        },
        "holds": {
          "title": "Holds",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "claimed_zone",
        "holds"
      ],
      "title": "Premise",
      "type": "object"
    },
    "PremiseValue": {
      "additionalProperties": false,
      "properties": {
        "premise_holds": {
          "title": "Premise Holds",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "premise_holds",
        "value"
      ],
      "title": "PremiseValue",
      "type": "object"
    },
    "ProgramStep": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Args",
          "type": "array"
        },
        "op": {
          "$ref": "#/$defs/Op"
        },
        "step_id": {
          "pattern": "^s\\d+$",
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "op",
        "args"
      ],
      "title": "ProgramStep",
      "type": "object"
    },
    "QuestionProgram": {
      "additionalProperties": false,
      "properties": {
        "answer_type": {
          "$ref": "#/$defs/AnswerType"
        },
        "difficulty": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Difficulty",
          "type": "object"
        },
        "family": {
          "$ref": "#/$defs/Family"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "premise": {
          "anyOf": [
            {
              "$ref": "#/$defs/Premise"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "program_id": {
          "title": "Program Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/ProgramStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "text": {
          "minLength": 8,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "program_id",
        "family",
        "steps",
        "text",
        "answer_type"
      ],
      "title": "QuestionProgram",
      "type": "object"
    },
    "Split": {
      "enum": [
        "dev",
        "test",
        "sealed"
      ],
      "title": "Split",
      "type": "string"
    },
    "StepTrace": {
      "additionalProperties": false,
      "properties": {
        "codes": {
          "items": {
            "$ref": "#/$defs/ErrorCode"
          },
          "title": "Codes",
          "type": "array"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "inputs": {
          "items": {},
          "title": "Inputs",
          "type": "array"
        },
        "op": {
          "$ref": "#/$defs/Op"
        },
        "output": {
          "title": "Output"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "op",
        "inputs",
        "output"
      ],
      "title": "StepTrace",
      "type": "object"
    },
    "TwinRefs": {
      "additionalProperties": false,
      "properties": {
        "base_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Id"
        },
        "causal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causal Id"
        },
        "edit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edit"
        },
        "nuisance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nuisance Id"
        },
        "pixel_diff_frac": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixel Diff Frac"
        },
        "role": {
          "enum": [
            "base",
            "causal",
            "nuisance"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role"
      ],
      "title": "TwinRefs",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "CERTIFIED",
        "QUARANTINED"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "WitnessCheck": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "metric": {
          "title": "Metric",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "obj_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obj Id"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "name",
        "passed",
        "metric",
        "threshold",
        "code"
      ],
      "title": "WitnessCheck",
      "type": "object"
    },
    "ZoneName": {
      "enum": [
        "green",
        "amber",
        "red"
      ],
      "title": "ZoneName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer": {
      "$ref": "#/$defs/Answer"
    },
    "bundle_id": {
      "pattern": "^kw-[0-9a-f]{20}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "canary": {
      "pattern": "^KNOTWORK-CANARY-[0-9a-f]{32}$",
      "title": "Canary",
      "type": "string"
    },
    "certificate": {
      "$ref": "#/$defs/Certificate"
    },
    "family": {
      "$ref": "#/$defs/Family"
    },
    "files": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Files",
      "type": "object"
    },
    "freshness_receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Freshness Receipt Id",
      "type": "string"
    },
    "plugin": {
      "title": "Plugin",
      "type": "string"
    },
    "question": {
      "$ref": "#/$defs/QuestionProgram"
    },
    "scene_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scene Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_path": {
      "title": "Seed Path",
      "type": "string"
    },
    "split": {
      "$ref": "#/$defs/Split"
    },
    "twins": {
      "$ref": "#/$defs/TwinRefs"
    }
  },
  "required": [
    "bundle_id",
    "plugin",
    "family",
    "split",
    "seed_path",
    "scene_id",
    "question",
    "answer",
    "certificate",
    "freshness_receipt_id",
    "twins",
    "canary",
    "files"
  ],
  "title": "TaskBundle",
  "type": "object"
}
